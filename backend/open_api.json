  "components": {
    "schemas": {
      "AppStatus": {
        "type": "string",
        "enum": [
          "created",
          "deploying",
          "running",
          "unhealthy",
          "stopped",
          "failed",
          "deleting"
        ],
        "title": "AppStatus"
      },
      "ApplicationCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "git_url": {
            "type": "string",
            "title": "Git Url"
          },
          "branch": {
            "type": "string",
            "title": "Branch",
            "default": "main"
          },
          "dockerfile_path": {
            "type": "string",
            "title": "Dockerfile Path",
            "default": "./Dockerfile"
          },
          "port": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Port",
            "default": 8000
          },
          "env_vars": {
            "additionalProperties": true,
            "type": "object",
            "title": "Env Vars"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "desired_replicas": {
            "type": "integer",
            "title": "Desired Replicas",
            "default": 1
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "git_url",
          "env_vars",
          "domain",
          "project_id"
        ],
        "title": "ApplicationCreate"
      },
      "ApplicationResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "git_url": {
            "type": "string",
            "title": "Git Url"
          },
          "branch": {
            "type": "string",
            "title": "Branch",
            "default": "main"
          },
          "dockerfile_path": {
            "type": "string",
            "title": "Dockerfile Path",
            "default": "./Dockerfile"
          },
          "port": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Port",
            "default": 8000
          },
          "env_vars": {
            "additionalProperties": true,
            "type": "object",
            "title": "Env Vars"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "desired_replicas": {
            "type": "integer",
            "title": "Desired Replicas",
            "default": 1
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "id": {
            "type": "string",
            "format": "uuid",
